{
	"name": "@cuecraft/byok",
	"version": "0.0.0-private",
	"description": "Provider runtime, model discovery, and text/object generation for BYOK AI apps.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		}
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"typecheck:examples": "tsc -p tsconfig.examples.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cuecraft/byok.git"
	},
	"bugs": {
		"url": "https://github.com/cuecraft/byok/issues"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.81",
		"@ai-sdk/google": "^3.0.80",
		"@ai-sdk/openai": "^3.0.68",
		"@ai-sdk/provider-utils": "^4.0.27",
		"@ai-sdk/xai": "^3.0.93",
		"@anthropic-ai/sdk": "^0.104.1",
		"@google/genai": "^2.8.0",
		"ai": "^6.0.197",
		"ollama": "^0.6.3",
		"openai": "^6.42.0",
		"tslib": "2.6.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^24.0.4",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
