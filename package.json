{
	"name": "cuecraft",
	"version": "0.1.0",
	"description": "AI-powered active-recall study cues for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"study",
		"active-recall",
		"spaced-repetition",
		"ai"
	],
	"author": "swartzrock",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.20.0",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.3.3",
		"vitest": "^1.6.1"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.81",
		"@ai-sdk/google": "^3.0.80",
		"@ai-sdk/openai": "^3.0.68",
		"@ai-sdk/xai": "^3.0.93",
		"@anthropic-ai/sdk": "^0.104.1",
		"@google/genai": "^2.8.0",
		"ai": "^6.0.197",
		"ollama": "^0.6.3",
		"openai": "^6.42.0",
		"zod": "^3.25.76"
	}
}