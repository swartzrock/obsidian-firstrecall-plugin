{
	"name": "firstrecall",
	"version": "1.1.0",
	"description": "Create active-recall Note Briefs and section study cards in Obsidian without modifying source Markdown.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"check": "bun run lint && bun run build && bun run typecheck && bun run test",
		"changeset": "changeset",
		"changeset:version": "changeset version && node version-bump.mjs",
		"dev": "bun esbuild.config.mjs",
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"study",
		"active-recall",
		"ai"
	],
	"author": "swartzrock",
	"license": "GPL-3.0-only",
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@eslint/json": "^2.1.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^24.19.2",
		"@typescript-eslint/parser": "^8.72.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"jiti": "^2.4.2",
		"jsdom": "^31.0.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@lobehub/icons-static-svg": "^1.102.0",
		"@swartzrock/byok-runtime": "3.1.0",
		"zod": "4.6.7"
	}
}
