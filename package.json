{
	"name": "cuecraft",
	"version": "0.1.0",
	"description": "AI-powered active-recall study cues for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"study",
		"active-recall",
		"spaced-repetition",
		"ai"
	],
	"author": "swartzrock",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/js": "^9.29.0",
		"@eslint/json": "^0.14.0",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.0.4",
		"@typescript-eslint/parser": "^8.34.1",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"eslint-plugin-n": "^17.21.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint": "^9.29.0",
		"globals": "^16.2.0",
		"jiti": "^2.4.2",
		"jsdom": "^26.1.0",
		"obsidian": "^1.8.10",
		"tslib": "2.6.2",
		"typescript-eslint": "^8.34.1",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.104.1",
		"@swartzrock/byok-runtime": "2.3.0",
		"zod": "^3.25.76"
	}
}
