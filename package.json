{
	"name": "firstrecall",
	"version": "0.6.1",
	"description": "Create active-recall Note Briefs and section study cards in Obsidian without modifying source Markdown.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"check": "bun run lint && bun run build && bun run typecheck && bun run test",
		"changeset": "changeset",
		"changeset:version": "changeset version && node version-bump.mjs",
		"dev": "bun esbuild.config.mjs",
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc -noEmit -skipLibCheck"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"study",
		"active-recall",
		"ai"
	],
	"author": "swartzrock",
	"license": "MIT",
	"packageManager": "bun@1.3.14",
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/json": "^0.14.0",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.0.4",
		"@typescript-eslint/parser": "^8.34.1",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.29.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"jiti": "^2.4.2",
		"jsdom": "^26.1.0",
		"obsidian": "^1.8.10",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.34.1",
		"vitest": "^3.2.4",
		"zod": "4.4.3"
	},
	"dependencies": {
		"@lobehub/icons-static-svg": "^1.94.0",
		"@swartzrock/byok-runtime": "3.1.0"
	}
}
