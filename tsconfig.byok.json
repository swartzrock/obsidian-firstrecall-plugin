{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowJs": false,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"moduleResolution": "bundler",
		"outDir": ".tmp/byok-types",
		"rootDir": "src/byok",
		"skipLibCheck": true
	},
	"include": ["src/byok/**/*.ts"]
}
